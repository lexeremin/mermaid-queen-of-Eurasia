# Copy to .env (git-ignored) and fill in. Only the publishable/anon key belongs here.
# NEVER put a service_role or sb_secret_ key in this file, in .env, or anywhere in the client.
# Without these the game runs local-only (offline mode).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Older projects: VITE_SUPABASE_ANON_KEY=eyJ... also works.
